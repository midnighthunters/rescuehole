# Git LFS configuration for large binaries and Unity iOS build artifacts
# Large iOS Framework binaries and tools
Build/ios/Frameworks/UnityRuntime.framework/UnityRuntime filter=lfs diff=lfs merge=lfs -text
**/UnityRuntime filter=lfs diff=lfs merge=lfs -text
*.framework/* filter=lfs diff=lfs merge=lfs -text
Build/ios/usymtool filter=lfs diff=lfs merge=lfs -text
Build/ios/usymtoolarm64 filter=lfs diff=lfs merge=lfs -text
**/usymtool* filter=lfs diff=lfs merge=lfs -text
# Binary assets, data, and libraries
*.resS filter=lfs diff=lfs merge=lfs -text
*.assets filter=lfs diff=lfs merge=lfs -text
*.dat filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.a filter=lfs diff=lfs merge=lfs -text
Build/ios/Data/globalgamemanagers filter=lfs diff=lfs merge=lfs -text
Build/ios/Data/level* filter=lfs diff=lfs merge=lfs -text
Build/ios/Data/Resources/* filter=lfs diff=lfs merge=lfs -text
# 3D Models & Audio in Assets
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
# Media and archive formats
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.ipa filter=lfs diff=lfs merge=lfs -text
Screenshots/** filter=lfs diff=lfs merge=lfs -text
