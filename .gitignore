# =========================================================================
# Unity GitIgnore Configuration
# =========================================================================

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
# Local build output (allow committed iOS build)
/[Bb]uild/*
!/[Bb]uild/ios/
/[Bb]uilds/

# Sensitive signing keys, certificates, and provisioning profiles
*.p8
*.mobileprovision
*.key
*.csr
*.cer
*.p12
# Asset meta files should never be ignored unless asset itself is ignored
!/[Aa]ssets/**/*.meta

# Autogenerated JetBrains Rider / Visual Studio files
.vs/
.idea/
.vscode/
.gradle/
ExportedObj/
.consulo/

# Generated solution and project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated meta files for temp objects
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt

# Build outputs
*.apk
*.aab
*.unitypackage
*.app

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editor swap files
*.swp
*~
